# Kopieren nach .env und anpassen
# Nur Verbindungen vom Spiel annehmen. Bei lokalem Testen auch http://localhost:8000 ergänzen
ALLOWED_ORIGINS=https://philippduck.github.io
# Port auf dem NAS (Standard 8090); ändern, falls belegt
# RELAY_PORT=8091
# Freiwillig: gemeinsamer Schlüssel. Ist er gesetzt, müssen alle Spieler ihn im Spiel unter „Eigener Server“ eintragen.
# RELAY_KEY=
